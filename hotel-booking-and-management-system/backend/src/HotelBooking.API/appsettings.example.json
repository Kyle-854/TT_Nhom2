{
  "ConnectionStrings": {
    "DefaultConnection": "server=YOUR_SERVER;port=3306;database=YOUR_DATABASE;user=YOUR_USER;password=YOUR_PASSWORD;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
